@import "../shared.wxss";

.doc-meta {
  display: block;
  margin-top: 8rpx;
  color: #8a6649;
  font-size: 22rpx;
}

.doc-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.doc-editor {
  width: 100%;
  height: 62vh;
  min-height: 660rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(121, 75, 34, 0.14);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #3a2a20;
  box-sizing: border-box;
  font-family: Consolas, "SF Mono", "PingFang SC", monospace;
  font-size: 25rpx;
  line-height: 1.6;
}

.doc-placeholder {
  padding: 28rpx;
  border: 2rpx solid rgba(122, 75, 34, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 246, 230, 0.66);
  color: #8a6649;
  font-size: 26rpx;
}

.doc-body {
  padding: 24rpx;
  border: 2rpx solid rgba(122, 75, 34, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 246, 230, 0.66);
}

.md-p {
  margin-bottom: 16rpx;
  color: #3a2a20;
  font-size: 27rpx;
  line-height: 1.65;
}

.md-heading {
  margin: 18rpx 0 14rpx;
  color: #2f2118;
  font-weight: 900;
  line-height: 1.35;
}

.md-heading.h1 {
  font-size: 38rpx;
}

.md-heading.h2 {
  font-size: 34rpx;
}

.md-heading.h3 {
  font-size: 30rpx;
}

.md-span.strong {
  color: #2f2118;
  font-weight: 900;
}

.md-span.em {
  color: #805a3c;
  font-style: italic;
}

.md-span.code {
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(66, 43, 29, 0.1);
  color: #623819;
  font-family: Consolas, "SF Mono", monospace;
  font-size: 24rpx;
}

.md-list {
  margin-bottom: 16rpx;
}

.md-li {
  display: flex;
  gap: 10rpx;
  margin: 8rpx 0;
  color: #3a2a20;
  font-size: 26rpx;
  line-height: 1.58;
}

.bullet {
  color: #c87325;
  font-weight: 900;
}

.li-content {
  flex: 1;
}

.md-hr {
  height: 2rpx;
  margin: 24rpx 0;
  background: linear-gradient(90deg, transparent, rgba(218, 133, 52, 0.5), transparent);
}

.md-space {
  height: 14rpx;
}

.md-table-scroll,
.md-code-scroll {
  max-width: 100%;
  margin: 16rpx 0;
}

.md-table {
  min-width: 620rpx;
  border-left: 2rpx solid rgba(122, 75, 34, 0.14);
  border-top: 2rpx solid rgba(122, 75, 34, 0.14);
}

.md-tr {
  display: flex;
}

.md-td {
  flex: 1;
  min-width: 190rpx;
  padding: 14rpx 16rpx;
  border-right: 2rpx solid rgba(122, 75, 34, 0.14);
  border-bottom: 2rpx solid rgba(122, 75, 34, 0.14);
  color: #4b3424;
  font-size: 23rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.md-th {
  background: rgba(255, 193, 107, 0.24);
  color: #5b3217;
  font-weight: 900;
}

.md-code-block {
  min-width: 560rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #34261e;
  box-sizing: border-box;
}

.md-code-lang {
  display: block;
  margin-bottom: 10rpx;
  color: #ffcf7a;
  font-size: 21rpx;
  font-weight: 900;
}

.md-code-text {
  display: block;
  color: #fff4df;
  font-family: Consolas, "SF Mono", monospace;
  font-size: 23rpx;
  line-height: 1.55;
  white-space: pre;
}
