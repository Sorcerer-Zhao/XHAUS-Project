@import "../shared.wxss";

.skill-meta {
  display: block;
  margin-top: 8rpx;
  color: #8a6649;
  font-size: 22rpx;
}

.skill-editor {
  width: 100%;
  height: 66vh;
  min-height: 720rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(121, 75, 34, 0.14);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #3a2a20;
  box-sizing: border-box;
  font-family: Consolas, "SF Mono", "PingFang SC", monospace;
  font-size: 25rpx;
  line-height: 1.6;
}
