<view class="page">
  <view class="nav-space" style="height: {{safeTop}}px;"></view>
  <view class="panel">
    <view class="head">
      <view>
        <text class="eyebrow">SKILL EDITOR</text>
        <text class="title">{{name}}</text>
        <text wx:if="{{updatedAt}}" class="skill-meta">{{updatedAt}}</text>
      </view>
      <view class="pill" bindtap="deleteSkill">{{deleting ? '删除中' : '删除'}}</view>
    </view>

    <view wx:if="{{loading}}" class="list-item muted">正在读取 Skill...</view>
    <view wx:elif="{{error}}" class="list-item muted">{{error}}</view>
    <view wx:else>
      <textarea
        class="skill-editor"
        value="{{content}}"
        placeholder="编辑 SKILL.md，可以删除不满意的条目，也可以追加新的能力说明。"
        placeholder-class="placeholder"
        maxlength="-1"
        bindinput="onContentInput"
      />
      <view class="primary {{saving ? 'disabled' : ''}}" bindtap="saveSkill">
        {{saving ? '保存中' : '保存修改'}}
      </view>
    </view>
  </view>
</view>
